#!/usr/bin/env bash

# rslink - A CLI tool to copy/move folders with optional symlink creation
# Usage: rslink [options] <source> <destination>

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Default options
MOVE=false
CREATE_SYMLINK=true
DELETE_AFTER=false
DRY_RUN=false
VERBOSE=false
SHOW_PROGRESS=true
RSYNC_OPTS="-a"

show_help() {
    cat << EOF
rslink - Copy or move folders using rsync with optional symlink creation

USAGE:
    rslink [OPTIONS] <source> <destination>

OPTIONS:
    -m, --move           Move mode: remove source after successful transfer
    -s, --symlink        Create symlink at source pointing to destination (default: true)
    --no-symlink         Don't create symlink
    -d, --delete         Delete source after transfer (alias for --move)
    -n, --dry-run        Show what would be done without making changes
    -v, --verbose        Show detailed output
    --progress           Show transfer progress (default: enabled)
    --no-progress        Disable progress display
    -h, --help           Show this help message

EXAMPLES:
    # Copy folder and create symlink
    rslink /path/to/source /path/to/destination

    # Move folder (delete source) and create symlink
    rslink --move /path/to/source /path/to/destination

    # Copy without creating symlink
    rslink --no-symlink /path/to/source /path/to/destination

    # Dry run to see what would happen
    rslink --dry-run /path/to/source /path/to/destination

EOF
}

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_verbose() {
    if [[ "$VERBOSE" == true ]]; then
        echo -e "[VERBOSE] $1"
    fi
}

# Format bytes to human readable
format_bytes() {
    local bytes=$1
    if [[ $bytes -lt 1024 ]]; then
        echo "${bytes}B"
    elif [[ $bytes -lt 1048576 ]]; then
        echo "$((bytes / 1024))KB"
    elif [[ $bytes -lt 1073741824 ]]; then
        echo "$((bytes / 1048576))MB"
    elif [[ $bytes -lt 1099511627776 ]]; then
        echo "$((bytes / 1073741824))GB"
    else
        echo "$((bytes / 1099511627776))TB"
    fi
}

# Get directory size
get_dir_size() {
    local path="$1"
    if [[ -d "$path" ]]; then
        du -sb "$path" 2>/dev/null | cut -f1 || echo "0"
    else
        stat -f%z "$path" 2>/dev/null || stat -c%s "$path" 2>/dev/null || echo "0"
    fi
}

# Get file count
get_file_count() {
    local path="$1"
    find "$path" -type f 2>/dev/null | wc -l | tr -d ' '
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -m|--move|-d|--delete)
            MOVE=true
            DELETE_AFTER=true
            shift
            ;;
        -s|--symlink)
            CREATE_SYMLINK=true
            shift
            ;;
        --no-symlink)
            CREATE_SYMLINK=false
            shift
            ;;
        -n|--dry-run)
            DRY_RUN=true
            RSYNC_OPTS="$RSYNC_OPTS --dry-run"
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            RSYNC_OPTS="$RSYNC_OPTS -v"
            shift
            ;;
        --progress)
            SHOW_PROGRESS=true
            shift
            ;;
        --no-progress)
            SHOW_PROGRESS=false
            shift
            ;;
        -*)
            log_error "Unknown option: $1"
            show_help
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# Check remaining arguments
if [[ $# -lt 2 ]]; then
    log_error "Source and destination are required"
    show_help
    exit 1
fi

SOURCE="$1"
DEST="$2"

# Remove trailing slash from source for consistent behavior
SOURCE="${SOURCE%/}"

# Resolve absolute paths
SOURCE_ABS="$(cd "$SOURCE" 2>/dev/null && pwd)" || SOURCE_ABS="$SOURCE"
DEST_ABS="$(cd "$DEST" 2>/dev/null && pwd)" || {
    # Try to resolve parent directory if destination doesn't exist yet
    DEST_ABS="$(cd "$(dirname "$DEST")" 2>/dev/null && pwd)/$(basename "$DEST")"
}

# Validate source exists
if [[ ! -e "$SOURCE" ]]; then
    log_error "Source does not exist: $SOURCE"
    exit 1
fi

# Get source basename for destination
SOURCE_BASENAME="$(basename "$SOURCE")"

# If destination is an existing directory, append source basename
if [[ -d "$DEST" ]]; then
    DEST_FINAL="$DEST/$SOURCE_BASENAME"
else
    DEST_FINAL="$DEST"
fi

# Resolve absolute path for final destination
DEST_PARENT="$(cd "$(dirname "$DEST_FINAL")" 2>/dev/null && pwd)"
DEST_FINAL_ABS="$DEST_PARENT/$(basename "$DEST_FINAL")"

# Calculate source size and file count
SOURCE_SIZE=$(get_dir_size "$SOURCE")
SOURCE_FILES=$(get_file_count "$SOURCE")

# Show plan
echo "────────────────────────────────────────────"
echo "Source:      $SOURCE"
echo "Destination: $DEST_FINAL"
echo "Size:        $(format_bytes $SOURCE_SIZE)"
echo "Files:       $SOURCE_FILES"
echo "────────────────────────────────────────────"
echo "Mode:        $([ "$MOVE" == true ] && echo "MOVE (delete source)" || echo "COPY")"
echo "Symlink:     $([ "$CREATE_SYMLINK == true" ] && echo "Yes" || echo "No")"
echo "Dry run:     $DRY_RUN"
echo "────────────────────────────────────────────"

# Run rsync
log_info "Starting rsync..."

# Check if destination already exists
if [[ -e "$DEST_FINAL" ]]; then
    log_verbose "Destination exists, syncing contents..."
    # Use trailing slash on source to sync contents into existing directory
    RSYNC_SOURCE="$SOURCE/"
else
    RSYNC_SOURCE="$SOURCE"
fi

# Build rsync command with progress if enabled
RSYNC_CMD="rsync $RSYNC_OPTS"
if [[ "$SHOW_PROGRESS" == true && "$VERBOSE" == false ]]; then
    RSYNC_CMD="$RSYNC_CMD --info=progress2"
fi

log_verbose "Command: $RSYNC_CMD \"$RSYNC_SOURCE\" \"$DEST_FINAL\""

# Run rsync and capture output
if [[ "$SHOW_PROGRESS" == true && "$VERBOSE" == false ]]; then
    # Show progress with pv or rsync progress
    if $RSYNC_CMD "$RSYNC_SOURCE" "$DEST_FINAL" 2>&1 | while IFS= read -r line; do
        if [[ "$line" =~ ([0-9]+) ]]; then
            echo -ne "\r$line"
        fi
    done; then
        echo ""  # New line after progress
        log_info "Rsync completed successfully"
    else
        echo ""
        log_error "Rsync failed"
        exit 1
    fi
else
    if $RSYNC_CMD "$RSYNC_SOURCE" "$DEST_FINAL"; then
        log_info "Rsync completed successfully"
    else
        log_error "Rsync failed"
        exit 1
    fi
fi

# Calculate transferred size (if destination exists)
if [[ -e "$DEST_FINAL" && "$DRY_RUN" == false ]]; then
    DEST_SIZE=$(get_dir_size "$DEST_FINAL")
    log_info "Transferred: $(format_bytes $DEST_SIZE)"
fi

# Handle move/delete and symlink creation
if [[ "$DRY_RUN" == false ]]; then
    # Move mode: remove source
    if [[ "$MOVE" == true ]]; then
        log_info "Removing source: $SOURCE"
        if [[ -d "$SOURCE" ]]; then
            rm -rf "$SOURCE"
        else
            rm -f "$SOURCE"
        fi
    fi

    # Create symlink at source location
    if [[ "$CREATE_SYMLINK" == true ]]; then
        # Check if source still exists
        if [[ -e "$SOURCE" ]]; then
            log_warn "Source still exists, skipping symlink creation"
            log_warn "Remove source first or use --move"
        else
            log_info "Creating symlink: $SOURCE -> $DEST_FINAL"
            # Get relative path for symlink if possible
            if ln -s "$DEST_FINAL" "$SOURCE" 2>/dev/null; then
                log_info "Symlink created successfully"
            else
                # Try with absolute path
                ln -sf "$DEST_FINAL_ABS" "$SOURCE_ABS"
                log_info "Symlink created successfully (absolute path)"
            fi
        fi
    fi
else
    echo ""
    log_info "Dry run complete - no changes were made"
    if [[ "$MOVE" == true ]]; then
        echo "  Would remove: $SOURCE"
    fi
    if [[ "$CREATE_SYMLINK" == true ]]; then
        echo "  Would create symlink: $SOURCE -> $DEST_FINAL"
    fi
fi

echo ""
log_info "Done!"
